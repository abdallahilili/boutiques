# Variables des Edge Functions. En production : `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement par Supabase ;
# elles ne sont à renseigner que pour `supabase functions serve` hors CLI.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Poivre servant à convertir le code à 4 chiffres en secret d'authentification (>= 16 caractères, à ne JAMAIS changer
# après la mise en production : tous les codes existants deviendraient invalides). Générer : openssl rand -hex 32
PIN_SECRET=
# Domaine technique des identités Auth dérivées des numéros de téléphone (jamais utilisé pour envoyer des emails).
PHONE_EMAIL_DOMAIN=tel.invalid
# Indicatif pays ajouté aux numéros locaux (Mauritanie : 222).
PAYS_INDICATIF=222

# --- Phase 2 ---
# Secret des tâches planifiées (subscription-cron, stock-alerts-cron) : en-tête x-cron-secret (>= 16 caractères). Générer : openssl rand -hex 32
CRON_SECRET=
# Secret du webhook de base de données on-order-created (en-tête x-cron-secret).
WEBHOOK_SECRET=
# Push FCM : JSON complet du compte de service Firebase (une seule ligne). FCM_PROJECT_ID est facultatif.
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=
# Domaines personnalisés (domain-verify) : cible DNS et rattachement Vercel (facultatif).
DOMAIN_CNAME_TARGET=cname.vercel-dns.com
DOMAIN_A_TARGETS=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
